NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://digio:digio_dev@localhost:5434/digio
REDIS_URL=redis://localhost:6380

QUOTE_TTL_MINUTES=15
CORS_ORIGINS=http://localhost:3000

# Customer app + public API URLs, used in payment redirects and SMS/WhatsApp links.
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Paystack (Ghana): cards + mobile money. Leave blank in development to use the
# built-in simulated checkout at /v1/payments/simulate/:reference.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
PAYMENTS_FALLBACK_EMAIL=bookings@digiogh.com

# WhatsApp Cloud API. Without credentials messages are rendered into the log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Set once Meta approves the utility template; otherwise free-form text is used.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# SMS: hubtel or termii. Without credentials messages are rendered into the log.
SMS_PROVIDER=
SMS_API_KEY=
SMS_CLIENT_ID=
SMS_SENDER_ID=DIGIO

# Outbox drainer. Leave on; tests disable it explicitly.
NOTIFICATIONS_DISPATCH_ENABLED=true

# Cloudflare R2 / S3-compatible
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
